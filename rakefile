    # end

    task :default do
        if BUILD_OS_LINUX
            packages = [
                "build-essential",
                "libegl1-mesa-dev",
                "libdbus-1-dev",
                "libgtk-3-dev", # for NDF (native file dialog), can theoretically be removed see sdl.h
                "libgtest-dev",
                "libfreetype-dev",
                "libsdl2-dev",
                # "libstdc++-11-dev", comes with clang in principle
            ].join(" ")

            system("sudo apt-get update && sudo apt-get install #{packages}")

        elsif BUILD_OS_WINDOWS
            #
            # Requires VCPKG
            #
            # clone https://github.com/microsoft/vcpkg
            # cd vcpkg
            # bootstrap-vcpkg.bat
            #
            # From there, you have access to vcpkg and pkg-config commands in the shell
            #
            packages = [
                "zlib",
                "libpng",
                "freetype",
                "sdl2",
                "opengl"
            ].join(" ")

            system("vcpkg install #{packages} --triplet x64-windows-static") # add --triplet x64-windows-static to get static libs
        else
            raise "Your system (#{BUILD_OS}) is not supported by this script"
        end

        if PLATFORM_WEB
            Rake::Task['install:emsdk'].invoke
        elsif PLATFORM_DESKTOP   
            Rake::Task['install:nativefiledialog'].invoke
        end
    end
end


desc "Count Line Of Code (requires cloc, count in ./src by default)"
task :cloc, [:arg1] do |t, args|
    _path = args[:arg1] || "./src"
    system("cloc --by-file-by-lang #{_path}")
end
