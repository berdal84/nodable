    "src/ndbl/core/language/Nodlang.parse_and_serialize.specs.cpp",
    "src/ndbl/core/language/Nodlang.parse_function_call.specs.cpp",
    "src/ndbl/core/language/Nodlang.parse_token.specs.cpp",
    "src/ndbl/core/language/Nodlang.tokenize.specs.cpp",
    "src/ndbl/test/main.cpp",
]

ndbl_test_gui_sources = FileList[
    "src/ndbl/gui/Nodable.specs.cpp"
]

ndbl_test.assets |= ndbl_app.assets # we load some .cpp files in tests

if HEADLESS_TESTS
    puts "HEADLESS_TESTS is TRUE, #{ndbl_test_gui_sources} won't be included." if VERBOSE
else
    ndbl_test.sources |= ndbl_test_gui_sources
end

ndbl_test.unity_build_slice_size = ndbl_test.sources.size

ndbl_test.vcpkg |= [
    "gtest"
]

ndbl_test.depends_on_target = [
    common
]

#---------------------------------------------------------------------------
# HIGH LEVEL TASKS
#---------------------------------------------------------------------------

desc "Running rake without task"
task :default => :help

desc "Print this help message"
task :help do
    print_help()
end

desc "Run nodable"
task :run =>  'nodable:run'

desc "Build nodable"
multitask :build => 'nodable:build'

desc "Build nodable"
multitask :build_all => ['nodable:build', 'tools-app-example:build']

if PLATFORM == PLATFORM_WINDOWS or PLATFORM == PLATFORM_LINUX
    desc "Run all tests"
    task :test => [
        'tools-tests:run',
        'nodable-tests:run'
    ]
else
    desc "Run all tests"
    task :test do
        puts "No tests to run when PLATFORM=#{PLATFORM}"
    end
end

desc "Clean and Build"
task :rebuild => [
    'clean',
    'build',
]

desc "Remove intermediate files"
define_clean_task()

desc "Remove intermediate files and any other files"
define_clobber_task()

task :rebuild_all do
    BUILD_CONFIGS.each do |each_config|
        system("rake -m clean build -- --config=#{each_config} --platform=#{PLATFORM}", exception: true)
    end
end

APT_PACKAGES = [
    "libx11-dev",
    "libgl1-mesa-dev",
]

def install_emsdk()
    system("python extern/emsdk/emsdk.py install latest --system", exception: true) # Make the "latest" SDK "active" for the current user. (writes .emscripten file)
end

def activate_emsdk()
    system("python extern/emsdk/emsdk.py activate latest --system", exception: true) # Make the "latest" SDK "active" for the current user. (writes .emscripten file)
end

task :ci do
    case PLATFORM
    when PLATFORM_LINUX            
        run_sudo_apt_install(APT_PACKAGES)
    when PLATFORM_WEB  
        install_emsdk()
        activate_emsdk()
    else
        puts "INFO: Nothing to install on CI for #{PLATFORM}"
    end    
end

desc "Install system dependencies"
task :install do
    case PLATFORM
    when PLATFORM_LINUX             
        run_sudo_apt_install(APT_PACKAGES)    
    when PLATFORM_WEB
        install_emsdk()
        activate_emsdk()
        puts("emsdk environment has been activated, consider running source extern/emsdk/emdsk_env.sh to get commands (emcc, emrun, etc)")
    else
        puts "INFO: Nothing to install on #{PLATFORM}"
    end
end

desc "Recompiles vcpkg binaries"
task :vcpkg_install do
    vcpkg_install()
end

desc "Count the lines of code in ./src folder"
task :count_lines do |t, args|
    count_lines_of_code('src')
end

#---------------------------------------------------------------------------
# TARGETS' TASKS - automatically generated
#---------------------------------------------------------------------------

target_define_tasks( extern )
target_define_tasks( common )
target_define_tasks( tools_app )
target_define_tasks( tools_test )
target_define_tasks( ndbl_app )
target_define_tasks( ndbl_test )

