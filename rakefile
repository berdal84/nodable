tests.sources |= FileList[
    "src/ndbl/core/Node.specs.cpp",
    "src/ndbl/core/Node_Slot.specs.cpp",
    "src/ndbl/core/Token.specs.cpp",
    "src/ndbl/core/Graph.specs.cpp",
    "src/ndbl/core/language/Nodlang.parse0.specs.cpp",
    "src/ndbl/core/language/Nodlang.parse1.specs.cpp",
    "src/ndbl/core/language/Nodlang.parse2.specs.cpp",
    "src/ndbl/core/language/Nodlang.parse3.specs.cpp",
    "src/ndbl/core/language/Nodlang.parse4.specs.cpp",
    "src/ndbl/test/main.cpp",

    "src/tools/core/Delegate.specs.cpp",
    "src/tools/core/reflection/index.specs.cpp",
    "src/tools/gui/geometry/Spatial_Node.specs.cpp",
    "src/tools/gui/geometry/Rect.specs.cpp",
]

tests_gui_sources = FileList[
    "src/ndbl/gui/Nodable.specs.cpp"
]

tests.assets |= ndbl_app.assets # we load some .cpp files in tests

if HEADLESS_TESTS
    puts "HEADLESS_TESTS is TRUE, #{tests_gui_sources} won't be included." if VERBOSE
else
    tests.sources |= tests_gui_sources
end

tests.unity_build_slice_size = tests.sources.size

tests.vcpkg |= [
    "gtest"
]

tests.depends_on_target = [
    common
]

#---------------------------------------------------------------------------
# HIGH LEVEL TASKS
#---------------------------------------------------------------------------

desc "Running rake without task"
task :default => :help

desc "Print this help message"
task :help do
    print_help()
end

desc "Run nodable"
task :run =>  'nodable:run'

desc "Build nodable"
multitask :build => 'nodable:build'

desc "Build nodable"
multitask :build_all => ['nodable:build', 'tools-app-example:build']

if PLATFORM == PLATFORM_WINDOWS or PLATFORM == PLATFORM_LINUX
    desc "Run all tests"
    task :test => 'tests:run'
else
    desc "Run all tests"
    task :test do
        puts "No tests to run when PLATFORM=#{PLATFORM}"
    end
end

desc "Clean and Build"
task :rebuild => [
    'clean',
    'build',
]

desc "Remove intermediate files"
define_clean_task()

desc "Remove intermediate files and any other files"
define_clobber_task()

task :rebuild_all do
    BUILD_CONFIGS.each do |each_config|
        system("rake -m clean build -- --config=#{each_config} --platform=#{PLATFORM}", exception: true)
    end
end

APT_PACKAGES = [
    "libx11-dev",
    "libgl1-mesa-dev",
]

def install_emsdk()
    system("python extern/emsdk/emsdk.py install latest --system", exception: true) # Make the "latest" SDK "active" for the current user. (writes .emscripten file)
end

def activate_emsdk()
    system("python extern/emsdk/emsdk.py activate latest --system", exception: true) # Make the "latest" SDK "active" for the current user. (writes .emscripten file)
end

task :ci do
    case PLATFORM
    when PLATFORM_LINUX            
        run_sudo_apt_install(APT_PACKAGES)
    when PLATFORM_WEB  
        install_emsdk()
        activate_emsdk()
    else
        puts "INFO: Nothing to install on CI for #{PLATFORM}"
    end    
end

desc "Install system dependencies"
task :install do
    case PLATFORM
    when PLATFORM_LINUX             
        run_sudo_apt_install(APT_PACKAGES)    
    when PLATFORM_WEB
        install_emsdk()
        activate_emsdk()
        puts("emsdk environment has been activated, consider running source extern/emsdk/emdsk_env.sh to get commands (emcc, emrun, etc)")
    else
        puts "INFO: Nothing to install on #{PLATFORM}"
    end
end

desc "Recompiles vcpkg binaries"
task :vcpkg_install do
    vcpkg_install()
end

desc "Count the lines of code in ./src folder"
task :count_lines do |t, args|
    count_lines_of_code('src')
end

#---------------------------------------------------------------------------
# TARGETS' TASKS - automatically generated
#---------------------------------------------------------------------------

target_define_tasks( extern )
target_define_tasks( common )
target_define_tasks( tools_app )
target_define_tasks( ndbl_app )
target_define_tasks( tests )

