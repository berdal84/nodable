    "src/ndbl/core/ASTNode.specs.cpp",
    "src/ndbl/core/ASTNodeSlot.specs.cpp",
    "src/ndbl/core/ASTToken.specs.cpp",
    "src/ndbl/core/Graph.specs.cpp",
