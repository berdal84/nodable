require 'fileutils'
require 'rake/clean'

require_relative 'rake/libs'
require_relative 'rake/base'
require_relative 'rake/tools'
require_relative 'rake/ndbl'

CLEAN.include [OBJ_DIR, DEP_DIR] # intermediate files
CLOBBER.include [BUILD_DIR] # final files

task :default => :help

desc "Print help message"
task :help do
    message = 
%{=-=-=-=-=-=-=-=- Welcome to Nodable's rakefile =-=-=-=-=-=-=-=-

    To start, run:
        rake --tasks

    It will print the list of all tasks

    Syntax for rake is:
        rake <task>
        rake <task1> <task2>

    Some useful tasks:
        clobber, clean, build, run, test.

}
    puts(message)
end

desc "Rebuild from scratch"
task :rebuild => [:clobber, :build] do
    print("Rebuild DONE\n")
end

task :run   => ['ndbl:app:run']

task :build => [
    'libs:build',
    'tools:app:build',
    'ndbl:app:build',
]

task :test  => [
    'tools:test',
    'ndbl:test'
]


desc "Rebuild all targets (web & desktop, debug & release)"
task :rebuild_all do

    targets     = ["web",   "desktop"]
    build_types = ["debug", "release"]

    targets.each do |platform|
        build_types.each do |build_type|
            system("rake -m clobber build TARGET=#{platform}  BUILD_TYPE=#{build_type}", exception: true)
        end
    end
end

task :install do

    if DESKTOP        
        
        if LINUX
            # The CI may not have it
            system("sudo apt install libx11-dev", exception: true)
        else
            puts "INFO: Nothing to install on #{ARCHITECTURE}-#{OS}"
        end
        
    elsif WEB
        # Download and install the latest SDK tools.
        system("extern/emsdk/emsdk install latest", exception: true)

        # Make the "latest" SDK "active" for the current user. (writes .emscripten file)
        system("extern/emsdk/emsdk activate latest", exception: true)
    end
end

task :vcpkg do
    system("vcpkg install --triplet #{VCPKG_TRIPLET} --x-install-root=./vcpkg/#{OS}", exception: true)
end

desc "Count Line Of Code (requires cloc, count in ./src by default)"
task :cloc, [:arg1] do |t, args|
    _path = args[:arg1] || "./src"
    system("cloc --by-file-by-lang #{_path}", exception: true)
end
