#---------------------------------------------------------------------------

tools_app = base_target("tools-app-example", TARGET_TYPE_EXECUTABLE)

tools_app.sources |= FileList[    
    "src/tools/gui-example/AppExample.cpp",
    "src/tools/gui-example/AppExampleView.cpp",
    "src/tools/gui-example/main.cpp"
]

tools_assets = FileList[
    # Fonts
    "fonts/CenturyGothic.ttf",
    "fonts/fa-solid-900.ttf",
    "fonts/JetBrainsMono-*.ttf", # 4 variants
]

if WEB # TODO: automatize this in build-tools.rb    
    # Preload assets (they will be compiled in a binary .data)
    tools_app.linker_flags |= tools_assets.map{|path| "--preload-file #{path}" }

    # Provide headers for deployment (note: requires https when deployed).
    tools_app.assets = [
        "http/.htaccess:.htaccess",
        "http/tools-app-example.html:tools-app-example.html",
    ]
else
    tools_app.assets = tools_assets
end

tools_app.depends_on_target = [
    common
]

#---------------------------------------------------------------------------

