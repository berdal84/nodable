    #     # Configure project
    #     system("cmake -S #{src_dir} -B #{build_dir}"

    #     # Build project
    #     system("cmake --build #{build_dir} --config #{config} --target zlibstatic"
    # end


    # task :png do

    #     src_dir   = "./libs/png"
    #     build_dir = "./#{BUILD_DIR}/libs/png"
    #     config    = "Release"

    #     # Make build directory
    #     FileUtils.mkdir_p build_dir
        
    #     # Configure project
    #     system("cmake -S #{src_dir} -B #{build_dir} -DCMAKE_BUILD_TYPE=#{config} -DBUILD_SHARED_LIBS=OFF"

    #     # Build project
    #     system("cmake --build #{build_dir} --config #{config}"
    # end

    # task :freetype do
    #     src_dir   = "./libs/freetype"
    #     build_dir = "./#{BUILD_DIR}/libs/freetype"
    #     config    = "Optimized"

    #     # Make build directory
    #     FileUtils.mkdir_p build_dir
        
    #     # Configure project
