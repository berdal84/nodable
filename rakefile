#---------------------------------------------------------------------------
# NODABLE TASKS
#---------------------------------------------------------------------------
#
# This file contains the high level tasks, most of the code is in rake/
# folder.
#
#   rake/build-tools.rb .. contains the build tools required to declare and
#                          compile/link a build target
#
#   rake/nodable.rb ...... contains the build targets and tasks for this project
#
#                                                            Bérenger, 2026.
#---------------------------------------------------------------------------

require 'fileutils'
require 'rake/clean'

require_relative 'rake/nodable'

#---------------------------------------------------------------------------
# AUTOGENERATED TASKS
#---------------------------------------------------------------------------

CLEAN.include [OBJ_DIR, DEP_DIR, BIN_DIR] # remove intermediate files
CLOBBER.include [OUTPUT_DIR]               # remove intermediate and any other build files

#---------------------------------------------------------------------------
# HIGH LEVEL TASKS
#---------------------------------------------------------------------------

task :default => :help

desc "Print this help message"
task :help do
    print $option_parser.help
    puts "\nMain tasks:"
    puts "\n"
    system('rake --tasks')
end

desc "Run nodable"
task :run =>  'ndbl:app:run'

desc "Build apps"
task :build => [
    'tools:app:build',
    'ndbl:app:build',
    'tools:test:build',
    'ndbl:test:build'
]

task :rebuild_all do
    TARGETS.each do |each_target|
        BUILD_CONFIGS.each do |each_build_config|
            system("rake -m clobber build -- --target=#{each_target}  --build=#{each_build_config}", exception: true)
        end
    end
end

desc "Build and run tests"
task :test  => [
    'tools:test',
    'ndbl:test'
]

desc "Run nodable"
task :run => 'ndbl:app:run'

desc "Install system dependencies"
task :install do

    if DESKTOP        
        
        if LINUX
            # The CI may not have it
            # Even if we add them via vcpkg for convenience, we still need to install the system packages
            apt_packages = [
                "libx11-dev",
                "libgl1-mesa-dev",
            ]
            system("sudo apt install #{apt_packages.join(" ")}", exception: true)
        else
            puts "INFO: Nothing to install on #{ARCH}-#{BUILD_OS}"
        end
        
    elsif WEB

        if LINUX
            system("extern/emsdk/emsdk install latest --system" , exception: true) # Download and install the latest SDK tools.
            system("extern/emsdk/emsdk activate latest --system", exception: true) # Make the "latest" SDK "active" for the current user. (writes .emscripten file)
            
        elsif WINDOWS
            system("extern/emsdk/emsdk.bat install latest --system" , exception: true) # Download and install the latest SDK tools.
            system("extern/emsdk/emsdk.bat activate latest --system", exception: true) # Make the "latest" SDK "active" for the current user. (writes .emscripten file)
        end

    end
end

desc "Recompiles vcpkg binaries"
task :vcpkg_install do
    bt_vcpkg_install()
end

desc "Count the lines of code in ./src folder"
task :count_lines do |t, args|
    bt_count_lines_of_code('src')
end
