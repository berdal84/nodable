require 'fileutils'
require 'rake/clean'

require_relative 'rake/libs'
require_relative 'rake/base'
require_relative 'rake/tools'
require_relative 'rake/ndbl'

CLEAN.include [OBJ_DIR, DEP_DIR] # intermediate files
CLOBBER.include [BUILD_DIR] # final files

task :default => :help

desc "Print help message"
task :help do
    message = 
%{=-=-=-=-=-=-=-=- Welcome to Nodable's rakefile =-=-=-=-=-=-=-=-

    To start, run:
        rake --tasks

    It will print the list of all tasks

    Syntax for rake is:
        rake <task>
        rake <task1> <task2>

    Some useful tasks:
        clobber, clean, build, run, test.

}
    puts(message)
end

desc "Rebuild from scratch"
task :rebuild => [:clobber, :build] do
    print("Rebuild DONE\n")
end

multitask :build => ['libs:build', 'tools:build', 'ndbl:build'] do puts "Build DONE" end
task :test  => ['tools:test', 'ndbl:test']
task :run   => ['ndbl:app:run']

desc "Rebuild all targets (web & desktop, debug & release)"
task :rebuild_all do

    platforms = ["web", "desktop"]
    build_types = ["debug", "release"]

    platforms.each do |platform|
        build_types.each do |build_type|
            system("rake -m clobber build PLATFORM=#{platform}  BUILD_TYPE=#{build_type}")
        end
    end
end

task :install => ['install:default']

namespace :install do
            
    task :emsdk do
        # Download and install the latest SDK tools.
        system("libs/emsdk/emsdk install latest")

        # Make the "latest" SDK "active" for the current user. (writes .emscripten file)
        system("libs/emsdk/emsdk activate latest")
    end

    task :nativefiledialog do
        src_dir   = "./libs/nativefiledialog-extended"
        build_dir = "./#{BUILD_DIR}/libs/nativefiledialog-extended"
        config    = "Release"

        FileUtils.mkdir_p build_dir
        
        # Configure project
        system("cmake -S #{src_dir} -B #{build_dir}")

        # Build project
        system("cmake --build #{build_dir} --config #{config}")

        # Install (in /usr/local)
        # Note: we install locally because it would require admin privileges to install system-wide.
        install_cmd = "cmake --install #{build_dir} --config #{config} --prefix #{build_dir}"
        if BUILD_OS_LINUX
            install_cmd = "sudo #{install_cmd}"
        end
        system(install_cmd)
    end

    # task :zlib  do

