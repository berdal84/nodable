require 'fileutils'
require 'rake/clean'

require_relative 'rake/base'
require_relative 'rake/tools'
require_relative 'rake/ndbl'

CLEAN.include [OBJ_DIR, DEP_DIR] # intermediate files
CLOBBER.include [BUILD_DIR] # final files

task :default => :help

desc "Print this help message"
task :help do
    print $option_parser.help
    puts "\nMain tasks:"
    puts "\n"
    system('rake --tasks')
end

desc "Run nodable"
task :run =>  'ndbl:app:run'

desc "Build apps"
task :build => [
    'tools:app:build',
    'ndbl:app:build',
    'tools:test:build',
    'ndbl:test:build'
]

desc "Build and run tests"
task :test  => [
    'tools:test',
    'ndbl:test'
]

desc "Run nodable"
task :run => 'ndbl:app:run'

task :rebuild_all do
    TARGETS.each do |each_target|
        BUILD_TYPES.each do |each_build_type|
            system("rake -m clobber build -- --target=#{each_target}  --build_type=#{each_build_type}", exception: true)
        end
    end
end

desc "Install system dependencies"
task :install do

    if DESKTOP        
        
        if LINUX
            # The CI may not have it
            # Even if we add them via vcpkg for convenience, we still need to install the system packages
            apt_packages = [
                "libx11-dev",
                "libgl1-mesa-dev",
            ]
            system("sudo apt install #{apt_packages.join(" ")}", exception: true)
        else
            puts "INFO: Nothing to install on #{ARCHITECTURE}-#{OS}"
        end
        
    elsif WEB
        # Download and install the latest SDK tools.
        system("extern/emsdk/emsdk install latest", exception: true)

        # Make the "latest" SDK "active" for the current user. (writes .emscripten file)
        system("extern/emsdk/emsdk activate latest", exception: true)
    end
end

desc "Recompiles vcpkg binaries"
task :vcpkg_install do
    vcpkg_install()
end

desc "Count the lines of code in ./src folder"
task :count_lines do |t, args|
    count_lines_of_code('src')
end
